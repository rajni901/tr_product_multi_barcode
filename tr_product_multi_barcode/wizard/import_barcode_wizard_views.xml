<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_barcode_wizard_form" model="ir.ui.view">
        <field name="name">import.barcode.wizard.form</field>
        <field name="model">import.barcode.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Barcodes from CSV">
                <div class="alert alert-info" role="alert">
                    <strong>CSV Format:</strong>
                    Columns required: <code>Internal Reference</code>, <code>Barcode</code>, <code>Note</code> (optional)
                </div>
                <group>
                    <field name="csv_file" filename="csv_filename" widget="binary"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_barcodes" model="ir.actions.act_window">
        <field name="name">Import Barcodes</field>
        <field name="res_model">import.barcode.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
